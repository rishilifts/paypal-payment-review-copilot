# PayPal sandbox credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: webhook intake
PAYPAL_WEBHOOK_ID=
PUBLIC_BASE_URL=
# AI provider: mock (default, no key needed) or meta (Llama 3.3 70B via OpenAI-compatible endpoint)
AI_PROVIDER=mock
META_API_KEY=
META_BASE_URL=https://api.meta.ai
META_MODEL=muse-spark-1.2
# Port
PORT=3000
